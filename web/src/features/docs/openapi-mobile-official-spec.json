{
  "openapi": "3.0.3",
  "info": {
    "title": "移动官方视频生成和素材库管理",
    "version": "2026-07-24.1",
    "description": "移动官方 Seedance 2.0 视频生成、素材库管理和真人认证接口。请求统一发送到 Nexus Reach API Gateway，并使用 Nexus Reach API Key 鉴权。"
  },
  "servers": [],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "移动官方视频生成和素材库管理",
      "description": "本组共 14 个接口：2 个 Seedance 2.0 视频任务接口、10 个素材与素材组接口、2 个真人认证接口。所有请求均携带 `Authorization: Bearer sk-your-key`。素材资源按客户作用域隔离；同一客户的多个 API Key 可共享素材，不同客户之间不能查询、修改或引用彼此资源。移动官方接口的成功响应通常包含 `requestId`、`state`、`errorCode`、`errorMessage` 和 `body`，读取 `body` 前应确认 `state` 为 `OK`。"
    }
  ],
  "paths": {
    "/v1/video/generations": {
      "post": {
        "tags": ["移动官方视频生成和素材库管理"],
        "summary": "创建 Seedance 2.0 视频生成任务",
        "operationId": "createMobileOfficialVideoGeneration",
        "description": "创建移动官方 Seedance 2.0 异步视频任务。网关使用顶层 `prompt` 生成官方 `text` 内容项，顶层 `content` 仅填写图片、视频或音频输入；官方的其他可选参数填写在 `metadata` 中。`model` 固定为 `doubao-seedance-2.0`。音频不能作为唯一媒体输入。素材库中的资源可使用 `asset://<assetId>` 引用，提交前应确认素材状态为 `ACTIVE`。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MobileVideoGenerationRequest"
              },
              "example": {
                "model": "doubao-seedance-2.0",
                "prompt": "以图片1为首帧，人物轻微自然眨眼，镜头保持固定，画面稳定，无字幕。",
                "content": [
                  {
                    "type": "image_url",
                    "image_url": {
                      "url": "asset://asset-20260711220537-lbswr"
                    },
                    "role": "first_frame"
                  }
                ],
                "resolution": "480p",
                "ratio": "1:1",
                "duration": 5,
                "generate_audio": false,
                "metadata": {
                  "return_last_frame": true,
                  "service_tier": "default",
                  "watermark": false
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务创建成功。`id` 与 `task_id` 均为网关公开任务 ID，后续查询使用该值。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MobileVideoSubmitResponse"
                },
                "example": {
                  "id": "task_01k0cmccseedance",
                  "task_id": "task_01k0cmccseedance",
                  "object": "video",
                  "model": "doubao-seedance-2.0",
                  "status": "queued",
                  "progress": 0,
                  "created_at": 1784851200
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "502": {
            "$ref": "#/components/responses/UpstreamError"
          }
        }
      }
    },
    "/v1/video/generations/{task_id}": {
      "get": {
        "tags": ["移动官方视频生成和素材库管理"],
        "summary": "查询 Seedance 2.0 视频生成任务",
        "operationId": "getMobileOfficialVideoGeneration",
        "description": "使用创建接口返回的公开任务 ID 查询网关中的异步任务记录。建议每 5～10 秒查询一次并逐步退避。任务成功后从 `data.result_url` 获取临时视频地址并及时保存；失败时读取 `data.fail_reason`。",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "description": "创建视频任务时返回的公开任务 ID。",
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "example": "task_01k0cmccseedance"
          }
        ],
        "responses": {
          "200": {
            "description": "任务查询成功。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MobileVideoTaskFetchResponse"
                },
                "example": {
                  "code": "success",
                  "data": {
                    "task_id": "task_01k0cmccseedance",
                    "status": "SUCCESS",
                    "fail_reason": "",
                    "result_url": "https://example.invalid/generated/video.mp4",
                    "submit_time": 1784851200,
                    "start_time": 1784851205,
                    "finish_time": 1784851290,
                    "progress": "100%"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/openapi-maas/exp/aicc/v2/asset": {
      "post": {
        "tags": ["移动官方视频生成和素材库管理"],
        "summary": "创建素材",
        "operationId": "createMobileOfficialAsset",
        "description": "使用可被上游访问的 HTTP/HTTPS 地址创建图片、视频或音频素材。`groupId` 必须属于当前客户作用域。成功响应的 `body` 为新素材 ID；创建后应查询素材详情，直到状态变为 `ACTIVE`。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MobileAssetCreateRequest"
              },
              "example": {
                "groupId": "group-20260711220534-nsbj6",
                "assetName": "人物首帧",
                "assetUrl": "https://example.invalid/assets/person.png",
                "assetType": "Image"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "素材创建请求成功。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MobileAssetIdResponse"
                },
                "example": {
                  "requestId": "aicc-request-001",
                  "state": "OK",
                  "errorCode": null,
                  "errorMessage": null,
                  "body": "asset-20260724210000-abcd1"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "502": {
            "$ref": "#/components/responses/UpstreamError"
          }
        }
      }
    },
    "/api/openapi-maas/exp/aicc/v2/asset/query": {
