# Compose project and the existing Docker network shared with the production edge.
COMPOSE_PROJECT_NAME=claw-workbench
WORKBENCH_EDGE_NETWORK=new-api-production

# The existing new-api container as seen from WORKBENCH_EDGE_NETWORK.
# This is reached only through the private TLS identity proxy; never publish it.
NEW_API_INTERNAL_UPSTREAM=http://REPLACE_WITH_NEW_API_ACTIVE:3000
NEW_API_INTERNAL_ALLOWED_HOSTS=REPLACE_WITH_NEW_API_ACTIVE

# The hardened ADP fork source. Relative paths are resolved from this directory.
ADP_SOURCE_DIR=../../../adp-chat-client-claw

# Production deploys only CI-built, scanned registry digests. On-host builds are
# development-only and rejected when CLAW_ENVIRONMENT=prod.
CLAW_BUILD_LOCAL_IMAGES=false
CLAW_CONTROL_IMAGE_BLUE=registry.example.invalid/claw-control@sha256:REPLACE_WITH_64_HEX_DIGEST
CLAW_CONTROL_IMAGE_GREEN=registry.example.invalid/claw-control@sha256:REPLACE_WITH_64_HEX_DIGEST
ADP_WORKBENCH_IMAGE_BLUE=registry.example.invalid/adp-chat-client@sha256:REPLACE_WITH_64_HEX_DIGEST
ADP_WORKBENCH_IMAGE_GREEN=registry.example.invalid/adp-chat-client@sha256:REPLACE_WITH_64_HEX_DIGEST
POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16.4-alpine
REDIS_IMAGE=docker.m.daocloud.io/library/redis:7.4-alpine
CADDY_IMAGE=docker.m.daocloud.io/library/caddy:2.10-alpine
# Production preflight requires an immutable digest. Keep the domestic mirror
# host, but replace the placeholder with the digest verified for that mirror.
CLAMAV_IMAGE=docker.m.daocloud.io/clamav/clamav@sha256:REPLACE_WITH_64_HEX_DIGEST
GO_BUILD_IMAGE=docker.m.daocloud.io/library/golang:1.22-alpine
BUN_BUILD_IMAGE=docker.m.daocloud.io/oven/bun:1.3.6-alpine
PYTHON_BUILD_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
NODE_BUILD_IMAGE=docker.m.daocloud.io/library/node:22-bookworm-slim
GOPROXY=https://goproxy.cn,direct
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
NPM_REGISTRY=https://registry.npmmirror.com

# Separate databases; neither is the existing new-api database.
CLAW_DB_NAME=claw_control
CLAW_DB_USER=claw_control
ADP_DB_NAME=adp_workbench
ADP_DB_USER=adp_workbench
POSTGRES_TIMEZONE=UTC

# Runtime policy. Both colors may run the idempotent, row-locked workers.
CLAW_ENVIRONMENT=prod
CLAW_PERIOD_RECONCILE_INTERVAL=1m
CLAW_OUTBOX_INTERVAL=1s
CLAW_MAINTENANCE_INTERVAL=1h
CLAW_EPHEMERAL_RETENTION=24h
CLAW_DELIVERED_OUTBOX_RETENTION=720h
CLAW_RETENTION_COORDINATOR_INTERVAL=5s
CLAW_RETENTION_COORDINATOR_TIMEOUT=15s
CLAW_REDIS_EVENT_CHANNEL=claw:control:events
WORKBENCH_CONTROL_EVENT_PROCESSED_TTL_SECONDS=604800
WORKBENCH_CONTROL_EVENT_MAX_BACKOFF_SECONDS=30
WORKBENCH_CONTROL_EVENT_MAX_BYTES=65536
WORKBENCH_USAGE_EVIDENCE_KEY_ID=v1
WORKBENCH_FILE_LOCATOR_KEY_ID=v1
WORKBENCH_WORKSPACE_LOCATOR_KEY_ID=v1
# Fail closed until the exact CreateWorkspaceCredential Domain suffix is verified.
WORKBENCH_WORKSPACE_HOST_SUFFIXES=
# Dynamic provider credentials are evicted after five idle minutes and the
# process cache is LRU-bounded. These values apply independently per ADP replica.
WORKBENCH_VENDOR_CACHE_IDLE_SECONDS=300
WORKBENCH_VENDOR_CACHE_MAX_ENTRIES=128
CLAW_CONTROL_SESSION_TTL=15m
CLAW_ADMIN_SESSION_TTL=30m
CLAW_ENTRY_TICKET_TTL=1m
CLAW_SSO_TICKET_TTL=1m
CLAW_APP_CONTEXT_TTL=1m
CLAW_INTERNAL_HMAC_TIME_SKEW=1m
CLAW_NEW_API_IDENTITY_STATUS_TIMEOUT=3s
CLAW_PROVIDER_VERIFICATION_TIMEOUT=15s
CLAW_EVIDENCE_ROOT=/var/lib/claw-control/evidence
CLAW_EVIDENCE_MAX_BYTES=10485760
CLAW_EVIDENCE_CLAMAV_TIMEOUT=15s
# Optional Tencent Fee Center read-only draft import. Keep false until the
# least-privilege Billing API credential files and actual PayerUin are ready.
CLAW_TENCENT_BILLING_IMPORT_ENABLED=false
CLAW_TENCENT_BILLING_PAYER_UIN=
CLAW_TENCENT_BILLING_IMPORT_INTERVAL=5s
CLAW_TENCENT_BILLING_TIMEOUT=15s
CLAW_TENCENT_BILLING_PAGE_SIZE=300
CLAW_TENCENT_BILLING_MAX_PAGES=100
CLAW_TENCENT_BILLING_MAX_RECORDS=30000
CLAW_TENCENT_BILLING_MAX_ATTEMPTS=3
CLAW_TENCENT_BILLING_LEASE_DURATION=30m
CLAW_TENCENT_BILLING_MAX_RESPONSE_BYTES=4194304
CLAW_DB_MAX_OPEN_CONNS=20
CLAW_DB_MAX_IDLE_CONNS=5
CLAW_DB_CONN_MAX_LIFETIME=30m

# Canonical browser origin and ADP behavior.
WORKBENCH_CANONICAL_ORIGIN=https://gateway.nexus-reach.com
WORKBENCH_SESSION_EXPIRE_MINUTES=15
WORKBENCH_STREAM_REAUTH_SECONDS=30
WORKBENCH_CONTROL_TIMEOUT_SECONDS=10
WORKBENCH_ALLOWED_CLOCK_SKEW_SECONDS=30
# Required in the managed production topology. Blue and Green both poll the
# signed control API; row leases guarantee a task is claimed once.
WORKBENCH_APP_MIGRATION_WORKER_ENABLED=true
WORKBENCH_APP_MIGRATION_POLL_SECONDS=5
WORKBENCH_APP_MIGRATION_LEASE_SECONDS=60
SERVER_RESPONSE_TIMEOUT=300
SSE_IDLE_TIMEOUT=5400
RATE_LIMIT=100/minute
LOG_LEVEL=INFO

# Private, fail-closed file pipeline. Keep disabled until the dedicated private
# bucket, least-privilege credentials, and healthy ClamAV service are verified.
WORKBENCH_FILES_ENABLED=false
WORKBENCH_FILE_SCANNER_PORT=3310
WORKBENCH_FILE_SCANNER_TIMEOUT_SECONDS=30
WORKBENCH_FILE_SCANNER_MAX_BYTES=52428800
WORKBENCH_FILE_ABSOLUTE_MAX_BYTES=52428800
WORKBENCH_FILE_QUARANTINE_CAPACITY_BYTES=104857600
WORKBENCH_FILE_MAX_CONCURRENT_UPLOADS=2
WORKBENCH_FILE_COS_REGION=ap-guangzhou
WORKBENCH_FILE_COS_BUCKET=
WORKBENCH_FILE_URL_EXPIRE_SECONDS=300
CLAMAV_STREAM_MAX_BYTES=52428800
CLAMAV_MAX_FILE_BYTES=52428800
CLAMAV_MAX_SCAN_BYTES=104857600
CLAMAV_FRESHCLAM_CHECKS=12

# Local offline scheduled tasks. Keep disabled until the customer plan contains
# scheduled_tasks and the PostgreSQL worker/authorization acceptance cases pass.
WORKBENCH_SCHEDULED_TASKS_ENABLED=false
WORKBENCH_SCHEDULE_REAUTH_SECONDS=300
WORKBENCH_SCHEDULE_WORKER_INTERVAL_SECONDS=5
WORKBENCH_SCHEDULE_LEASE_SECONDS=90
WORKBENCH_SCHEDULE_BATCH_SIZE=20
WORKBENCH_SCHEDULE_MIN_INTERVAL_MINUTES=15
WORKBENCH_SCHEDULE_MAX_TASKS_PER_USER=20
WORKBENCH_SCHEDULE_MAX_DAILY_RUNS=24
WORKBENCH_SCHEDULE_MAX_PROMPT_CHARS=16000
WORKBENCH_SCHEDULE_MAX_ATTACHMENTS=10
WORKBENCH_SCHEDULE_DELEGATION_DAYS=30
WORKBENCH_SCHEDULE_MISFIRE_GRACE_SECONDS=300

# Customer-visible integrations. Catalog/provider metadata is mounted from
# config/*.json; OAuth client secrets and independent JWE key rings are files.
# Keep disabled until the App dynamic-config switch is published and the
# allowlist, provider metadata, callback URI, and test accounts are verified.
WORKBENCH_INTEGRATIONS_ENABLED=false
WORKBENCH_CONNECTOR_TOKEN_KEY_ID=v1
WORKBENCH_OAUTH_STATE_KEY_ID=v1
WORKBENCH_OAUTH_STATE_TTL_SECONDS=300
WORKBENCH_INTEGRATION_REAUTH_SECONDS=300
WORKBENCH_OAUTH_HTTP_TIMEOUT_SECONDS=15
WORKBENCH_OAUTH_MAX_RESPONSE_BYTES=262144

# Optional Tencent AGSX managed sandbox. It is intentionally disabled until
# ToolId/ToolName, the four mounted secret files and a real acceptance account
# are available. PUBLIC/VPC/NONE network modes and auth modes other than TOKEN
# are rejected by preflight and runtime code.
WORKBENCH_SANDBOX_ENABLED=false
WORKBENCH_SANDBOX_CODE_ENABLED=false
WORKBENCH_SANDBOX_CODE_WORKER_MEMORY_BYTES=536870912
WORKBENCH_SANDBOX_PTY_ENABLED=false
WORKBENCH_SANDBOX_PTY_TICKET_TTL_SECONDS=30
WORKBENCH_SANDBOX_PTY_MAX_RUNTIME_SECONDS=600
WORKBENCH_SANDBOX_PTY_REAUTH_SECONDS=15
WORKBENCH_SANDBOX_PTY_HEARTBEAT_SECONDS=10
WORKBENCH_SANDBOX_PTY_STALE_SECONDS=45
WORKBENCH_SANDBOX_PTY_REAPER_SECONDS=15
WORKBENCH_SANDBOX_PTY_GLOBAL_CAPACITY=100
WORKBENCH_SANDBOX_PTY_CUSTOMER_CAPACITY=10
WORKBENCH_SANDBOX_PTY_USER_CAPACITY=2
WORKBENCH_SANDBOX_PTY_MAX_INPUT_FRAME_BYTES=16384
WORKBENCH_SANDBOX_PTY_MAX_OUTPUT_FRAME_BYTES=32768
WORKBENCH_SANDBOX_PTY_MAX_INPUT_BYTES=1048576
WORKBENCH_SANDBOX_PTY_MAX_OUTPUT_BYTES=8388608
WORKBENCH_SANDBOX_PTY_MAX_INPUT_FRAMES_PER_SECOND=30
WORKBENCH_SANDBOX_PTY_OUTPUT_QUEUE_FRAMES=32
WORKBENCH_SANDBOX_PROVIDER=tencent_agsx
WORKBENCH_AGSX_REGION=ap-guangzhou
WORKBENCH_AGSX_DOMAIN=ap-guangzhou.tencentags.com
WORKBENCH_AGSX_CONTROL_ENDPOINT=ags.tencentcloudapi.com
WORKBENCH_AGSX_TOOL_ID=
WORKBENCH_AGSX_TOOL_NAME=
WORKBENCH_SANDBOX_NETWORK_MODE=SANDBOX
WORKBENCH_SANDBOX_AUTH_MODE=TOKEN
WORKBENCH_SANDBOX_LEASE_SECONDS=30
WORKBENCH_SANDBOX_STARTS_PER_USER_MINUTE=6
WORKBENCH_SANDBOX_STARTS_PER_CUSTOMER_MINUTE=60
WORKBENCH_SANDBOX_TERMINAL_RETENTION_DAYS=30
WORKBENCH_SANDBOX_DEFAULT_TIMEOUT_SECONDS=600
WORKBENCH_SANDBOX_HARD_MAX_RUNTIME_SECONDS=3600
WORKBENCH_SANDBOX_MAX_COMMAND_SECONDS=120
WORKBENCH_SANDBOX_PROVIDER_TIMEOUT_SECONDS=30
WORKBENCH_SANDBOX_MAX_CODE_CHARS=65536
WORKBENCH_SANDBOX_MAX_COMMAND_CHARS=8192
WORKBENCH_SANDBOX_MAX_OUTPUT_BYTES=1048576
WORKBENCH_SANDBOX_HARD_MAX_FILE_BYTES=10485760

# Resource guardrails. Tune after the 50/100-SSE load test.
CLAW_CONTROL_CPUS=1.0
CLAW_CONTROL_MEMORY=512m
ADP_CPUS=2.0
ADP_MEMORY=2g
POSTGRES_MEMORY=1g
REDIS_MEMORY=512m
CLAMAV_CPUS=2.0
CLAMAV_MEMORY=4g

# Optional release metadata written to backup manifests (never put secrets here).
NEW_API_REVISION=
CLAW_CONTROL_REVISION=
ADP_REVISION=
# Prometheus endpoints are disabled by default outside this Compose overlay.
# This overlay enables container-network listeners only and never publishes
# 9090/9100 on the host. Do not add them to the public Caddy configuration.
CLAW_METRICS_ADDR=:9090
WORKBENCH_METRICS_ENABLED=true
WORKBENCH_METRICS_HOST=0.0.0.0
WORKBENCH_METRICS_PORT=9100
