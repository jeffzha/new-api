# Standalone HTTP listener.
CLAW_CONTROL_ADDR=:8090

# sqlite | mysql | postgres. claw-control must not point at the new-api database.
CLAW_DB_DRIVER=sqlite
CLAW_DB_DSN=file:claw-control.db?_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)

# Replace all values. They intentionally do not reuse new-api JWT, session, or API keys.
CLAW_ADMIN_TOKEN=replace-with-a-long-random-admin-bootstrap-token
CLAW_INTERNAL_HMAC_KEYS=adp-backend=replace-with-a-different-32-byte-random-value,new-api-core=replace-with-another-32-byte-random-value
CLAW_INTERNAL_HMAC_TIME_SKEW=5m
CLAW_NEW_API_SERVICE_NAME=new-api-core
CLAW_ADP_SERVICE_NAME=adp-backend
CLAW_SSO_TICKET_TTL=1m
CLAW_ENTRY_TICKET_TTL=1m
CLAW_CONTROL_SESSION_TTL=8h
CLAW_ADMIN_SESSION_TTL=30m
CLAW_APP_CONTEXT_TTL=1m
CLAW_NEW_API_IDENTITY_STATUS_URL=https://gateway.example.com/api/internal/workbench/identity-status
CLAW_NEW_API_ADMIN_IDENTITY_STATUS_URL=https://gateway.example.com/api/internal/workbench/admin-identity-status
CLAW_NEW_API_IDENTITY_STATUS_HMAC_SECRET=replace-with-a-third-independent-32-byte-secret
CLAW_NEW_API_IDENTITY_STATUS_TIMEOUT=3s
CLAW_ADP_SSO_REDIRECT_PATH=/workbench/auth/sso
CLAW_ADMIN_REDIRECT_PATH=/workbench/admin
CLAW_ADMIN_ASSET_DIR=/app/admin-ui
CLAW_PROVIDER_VERIFICATION_TIMEOUT=15s

# Encrypted operational evidence. Generate the key with:
#   openssl rand -base64 32
# Keep it independent from every other secret and back it up separately.
CLAW_EVIDENCE_MASTER_KEY=replace-with-standard-base64-for-exactly-32-random-bytes
CLAW_EVIDENCE_ROOT=/var/lib/claw-control/evidence
CLAW_EVIDENCE_MAX_BYTES=10485760
CLAW_EVIDENCE_CLAMAV_ADDR=127.0.0.1:3310
CLAW_EVIDENCE_CLAMAV_TIMEOUT=15s

# Optional read-only Tencent Fee Center import. It is disabled by default.
# SecretId/SecretKey are process-only values and must come from a secret
# manager or runtime environment; never save them in the control database.
CLAW_TENCENT_BILLING_IMPORT_ENABLED=false
CLAW_TENCENT_BILLING_SECRET_ID=
CLAW_TENCENT_BILLING_SECRET_KEY=
CLAW_TENCENT_BILLING_PAYER_UIN=
CLAW_TENCENT_BILLING_IMPORT_INTERVAL=5s
CLAW_TENCENT_BILLING_TIMEOUT=15s
CLAW_TENCENT_BILLING_PAGE_SIZE=300
CLAW_TENCENT_BILLING_MAX_PAGES=100
CLAW_TENCENT_BILLING_MAX_RECORDS=30000
CLAW_TENCENT_BILLING_MAX_ATTEMPTS=3
CLAW_TENCENT_BILLING_LEASE_DURATION=30m
CLAW_TENCENT_BILLING_MAX_RESPONSE_BYTES=4194304

# Used when building immutable canonical subjects.
CLAW_ENVIRONMENT=prod
# Migration guard only. Production rejects true and exposes no self-reported verification route.
CLAW_ALLOW_UNTRUSTED_PROVIDER_VERIFICATION=false

# Reliable background workers. Redis carries durable stream events plus immediate
# Pub/Sub invalidation; its password must be injected from a secret, not committed.
CLAW_PERIOD_RECONCILE_INTERVAL=1m
CLAW_OUTBOX_INTERVAL=1s
CLAW_MAINTENANCE_INTERVAL=1h
CLAW_EPHEMERAL_RETENTION=24h
CLAW_DELIVERED_OUTBOX_RETENTION=720h
# Disabled unless explicitly configured. Production must use the exact private
# ADP endpoint; the existing adp-backend HMAC key signs both request and receipt.
CLAW_ADP_RETENTION_URL=https://workbench-control.internal:8443/api/internal/workbench/retention/intents
CLAW_RETENTION_COORDINATOR_INTERVAL=5s
CLAW_RETENTION_COORDINATOR_TIMEOUT=15s
CLAW_REDIS_ADDR=127.0.0.1:6379
CLAW_REDIS_PASSWORD=replace-from-secret
CLAW_REDIS_DB=0
CLAW_REDIS_EVENT_CHANNEL=claw:control:events

# Database pool settings.
CLAW_DB_MAX_OPEN_CONNS=20
CLAW_DB_MAX_IDLE_CONNS=5
CLAW_DB_CONN_MAX_LIFETIME=30m
