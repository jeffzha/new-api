.env
__pycache__/
*.py[cod]
backups/*
!backups/.gitkeep
secrets/*
!secrets/.gitkeep
!secrets/provider/
secrets/provider/*
!secrets/provider/.gitkeep
!secrets/oauth/
secrets/oauth/*
!secrets/oauth/.gitkeep
!secrets/sandbox/
secrets/sandbox/*
!secrets/sandbox/.gitkeep
config/*.json
state/*
!state/.gitkeep
