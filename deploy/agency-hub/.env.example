# Use SQLite automatically when SQL_DSN is empty (local development only).
# SQLITE_PATH=./data/agency-local.db

# Production: point Agency Hub at the existing gateway PostgreSQL database.
SQL_DSN=postgresql://newapi:CHANGE_ME@postgres:5432/newapi
LOG_SQL_DSN=

AGENCY_HUB_PUBLIC_BASE_URL=https://gateway.example.com
AGENCY_HUB_PLATFORM_BASE_URL=https://gateway.example.com
AGENCY_HUB_AUTO_MIGRATE=false
AGENCY_ONBOARDING_ENABLED=false
AGENCY_HUB_COMMISSION_PROCESSING_ENABLED=false
AGENCY_HUB_WITHDRAWALS_ENABLED=false
AGENCY_HUB_EXPORT_DIR=/var/lib/agency-hub/exports
AGENCY_HUB_INSTANCE_ID=agency-hub-1
AGENCY_HUB_SQL_MAX_OPEN_CONNS=20
AGENCY_HUB_SQL_MAX_IDLE_CONNS=5
AGENCY_HUB_CPUS=0.75
AGENCY_HUB_MEMORY_LIMIT=768m

# Host paths to the five secret files required by docker-compose.yml.
AGENCY_HUB_SSO_PUBLIC_KEY_HOST_FILE=./secrets/agency_sso_public.pem
AGENCY_HUB_COMMAND_SERVICE_PUBLIC_KEY_HOST_FILE=./secrets/agency_command_service_public.pem
AGENCY_HUB_COMMAND_SERVICE_PRIVATE_KEY_HOST_FILE=./secrets/agency_command_service_private.pem
AGENCY_HUB_DELIVERY_KEY_FILE=./secrets/agency_delivery.key
AGENCY_PAYOUT_KEY_FILE=./secrets/agency_payout.key
