[Unit]
Description=Claw Workbench verified two-region encrypted backup
Documentation=file:/opt/new-api/deploy/claw-workbench/dr/README.md
Wants=network-online.target
After=network-online.target docker.service
ConditionPathExists=/etc/claw-workbench/dr.json
ConditionPathExists=/etc/claw-workbench/dr.env

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/new-api/deploy/claw-workbench
EnvironmentFile=/etc/claw-workbench/dr.env
UMask=0077
ExecStart=/usr/bin/python3 /opt/new-api/deploy/claw-workbench/dr/dr.py backup --config /etc/claw-workbench/dr.json --output /var/lib/claw-workbench-dr-reports/latest-backup --write --confirm WRITE_BOTH_REGIONS
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/new-api/deploy/claw-workbench/backups /var/lib/claw-workbench-dr-reports /run/docker.sock
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
TimeoutStartSec=6h
