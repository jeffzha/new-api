[Unit]
Description=Claw Workbench full restic data verification in both regions
Documentation=file:/opt/new-api/deploy/claw-workbench/dr/README.md
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/claw-workbench/dr.json
ConditionPathExists=/etc/claw-workbench/dr.env

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/new-api/deploy/claw-workbench
EnvironmentFile=/etc/claw-workbench/dr.env
UMask=0077
ExecStart=/usr/bin/python3 /opt/new-api/deploy/claw-workbench/dr/dr.py check --config /etc/claw-workbench/dr.json --output /var/lib/claw-workbench-dr-reports/latest-check --execute --confirm CHECK_BOTH_REPOSITORIES
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/claw-workbench-dr-reports
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
TimeoutStartSec=12h
