# Merge into a private deployment environment file only after checking subnet
# overlap with the host, VPC and all existing Docker networks. These are examples.
AGENCY_COMMAND_SUBNET=172.30.250.0/29
AGENCY_COMMAND_BLUE_IP=172.30.250.2
AGENCY_COMMAND_GREEN_IP=172.30.250.3
AGENCY_COMMAND_HUB_IP=172.30.250.4
# Select a gateway that already runs the compatible command listener.
AGENCY_COMMAND_TARGET_IP=172.30.250.2

# Absolute host paths. Never mount the CA private key into a service.
AGENCY_COMMAND_CA_HOST_FILE=/opt/new-api/deploy/agency-command-secrets/ca.crt
AGENCY_COMMAND_SERVER_CERT_HOST_FILE=/opt/new-api/deploy/agency-command-secrets/server.crt
AGENCY_COMMAND_SERVER_KEY_HOST_FILE=/opt/new-api/deploy/agency-command-secrets/server.key
AGENCY_COMMAND_CLIENT_CERT_HOST_FILE=/opt/new-api/deploy/agency-command-secrets/client.crt
AGENCY_COMMAND_CLIENT_KEY_HOST_FILE=/opt/new-api/deploy/agency-command-secrets/client.key
# These must match the existing Root proof and Hub service signing keys.
AGENCY_HUB_SSO_PUBLIC_KEY_HOST_FILE=/opt/new-api/deploy/agency-secrets/agency_sso_public.pem
AGENCY_HUB_COMMAND_SERVICE_PUBLIC_KEY_HOST_FILE=/opt/new-api/deploy/agency-secrets/agency_command_service_public.pem
