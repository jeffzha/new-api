# Add these values to BOTH existing new-api Blue and Green instances.
# Keep the feature off until the complete P0 E2E suite has passed.
WORKBENCH_ENABLED=false

# workbench-control.internal is the private TLS alias of workbench-switch on
# the existing edge Docker network. No host port is published. Mount the same
# internal CA used by this overlay and point SSL_CERT_FILE at it.
WORKBENCH_CONTROL_URL=https://workbench-control.internal:8443
WORKBENCH_ALLOW_INSECURE_CONTROL_HTTP=false
SSL_CERT_FILE=/run/secrets/internal_ca
WORKBENCH_CONTROL_SERVICE_NAME=new-api-core

# Inject these two distinct values through the production secret manager.
# They must match secrets/new_api_control_hmac and
# secrets/new_api_identity_hmac respectively; never reuse JWT/session/API keys.
WORKBENCH_CONTROL_HMAC_SECRET=REPLACE_VIA_SECRET_MANAGER
WORKBENCH_SERVICE_HMAC_SECRET=REPLACE_VIA_SECRET_MANAGER

# Optional bounded timeouts supported by the bridge.
WORKBENCH_CONTROL_TIMEOUT_MS=3000
WORKBENCH_INTERNAL_MAX_SKEW_SECONDS=60
