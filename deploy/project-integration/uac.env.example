# Project instance only. Keep these out of product database options.
# Generate a distinct SESSION_SECRET for this instance. Never reuse the product
# instance's session signing secret, even when sharing its primary database.
SESSION_SECRET=
UAC_OIDC_ENABLED=true
UAC_OIDC_REQUIRED=true
UAC_PUBLIC_URL=https://gateway.nexus-reach.com/test
UAC_OIDC_ISSUER=
UAC_OIDC_CLIENT_ID=
UAC_OIDC_CLIENT_SECRET=
# Optional private CA bundle, provided through a trusted channel.
UAC_OIDC_CA_FILE=
# 10 = administrator; 100 = super administrator. Applied on FIRST login only.
UAC_INITIAL_ROLE=10
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_TRUSTED_URL=https://gateway.nexus-reach.com
# Frontend build settings (build this worktree's web output separately).
VITE_INSTANCE_BASE_PATH=/test
VITE_UAC_INSTANCE=true
VITE_UAC_REQUIRED=true
# This first implementation holds UAC sessions in server memory. Use a single
# project instance; restart requires sign-in. It does not store UAC tokens in DB.
