    "react-dom": "latest",
    "react-i18next": "latest",
    "typescript": "5.9.3",
    "vite": "4.5.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2"
  }
}
