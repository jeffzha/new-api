ARG GO_BUILD_IMAGE=docker.m.daocloud.io/library/golang:1.26.6-alpine@sha256:af8d6740070b8906d12eae1c3e3ea0957fb63f492051ea05e354c38ef9fe88df
ARG BUN_BUILD_IMAGE=docker.m.daocloud.io/oven/bun:1.3.6-alpine

FROM ${BUN_BUILD_IMAGE} AS admin-ui-build

ARG NPM_REGISTRY=https://registry.npmmirror.com
WORKDIR /src/claw-control/admin-ui

COPY claw-control/admin-ui/package.json claw-control/admin-ui/bun.lock ./
RUN bun install --frozen-lockfile --registry "${NPM_REGISTRY}"
COPY claw-control/admin-ui/ ./
RUN bun run typecheck
RUN bun run test
RUN bun run build

FROM ${GO_BUILD_IMAGE} AS control-build

ARG GOPROXY=https://goproxy.cn,direct
ENV CGO_ENABLED=0 \
    GOPROXY=${GOPROXY}
WORKDIR /src/claw-control

COPY claw-control/go.mod claw-control/go.sum ./
RUN go mod download
COPY claw-control/ ./
RUN go test ./... && go build -trimpath -ldflags="-s -w" -o /out/claw-control ./cmd/server

FROM docker.m.daocloud.io/library/alpine:3.20
RUN apk upgrade --no-cache && apk add --no-cache ca-certificates tzdata wget
RUN addgroup -S -g 10001 workbench && adduser -S -D -H -u 10001 -G workbench workbench
RUN mkdir -p /var/lib/claw-control/evidence && chown -R 10001:10001 /var/lib/claw-control
WORKDIR /app
COPY --from=control-build /out/claw-control /app/claw-control
COPY --from=admin-ui-build --chown=10001:10001 /src/claw-control/admin-ui/dist/ /app/admin-ui/
COPY deploy/claw-workbench/docker/entrypoint-control.sh /app/entrypoint.sh
RUN chmod 0555 /app/claw-control /app/entrypoint.sh
RUN chmod -R a=rX /app/admin-ui
USER 10001:10001
EXPOSE 8090
ENTRYPOINT ["/app/entrypoint.sh"]
